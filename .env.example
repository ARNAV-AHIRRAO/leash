# Copy this file to ".env" (same folder) and fill it in. Never commit ".env".

# --- PayPal SANDBOX (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Optional. Only needed if you add a webhook (the app also polls PayPal every 10 s).
PAYPAL_WEBHOOK_ID=

# --- Sandbox PERSONAL account emails that receive the demo payouts ---
VENDOR1_EMAIL=
VENDOR2_EMAIL=
VENDOR3_EMAIL=

# --- Gemini (aistudio.google.com > Get API key). Optional: without it a built-in parser is used. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-flash-latest

# --- Optional ---
# PORT=3000
# DATA_DIR=./data
# PAYPAL_MODE=mock   (force simulated payouts even if credentials are present)
